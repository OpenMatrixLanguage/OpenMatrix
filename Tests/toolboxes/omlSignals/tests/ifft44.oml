addtoolbox omlsignals

% define real signal
f1 = 62.5;
f2 = 125;
f3 = 250;
omega1 = 2*pi*f1;
omega2 = 2*pi*f2;
omega3 = 2*pi*f3;
phi1 = -pi / 6;
phi2 = pi / 6;
phi3 = pi / 3;
fs = 1000;
ts = 1/fs;
n = 16;
t = [0:ts:(n-1)*ts];
signal = 2.0*cos(omega1*t+phi1) + 4.0*cos(omega2*t+phi2) + 3.0*cos(omega3*t+phi3);
signal = signal';
signal2 = [signal, circshift(signal,2), circshift(signal,4), circshift(signal,6)];
signal2 = permute(signal2,[2,1]);

% analyze signal spectrum
freqRes = fft(signal2,[],2);
freqRes(1,16) = 2 * freqRes(1,2);	% make asymmetrical
signal2 = ifft(freqRes,20,2,'symmetric');
signal2 = round(100000000 * signal2) / 100000000
