addtoolbox omlpolynom

sz = [10, 12, 9, 14, 11];
n = prod(sz);
V = reshape([1:n], sz);
V(:,[1:5]) = V(:,[2,5,1,4,3]);
V([1:5],:) = V([3,1,4,5,2],:);
x1 = [-11:1:-2];
x2 = [50:2:72];
x3 = [10:2:26];
x4 = [100:5:165];
x5 = [15:3:45];
y1 = [-7.4, -3.8];
y2 = [57.2, 64.9];
y3 = [15, 18, 20.5];
y4 = [108, 126, 147];
y5 = [20, 30, 40];
VI = interpn(x1, x2, x3, x4, x5, V, y1, y2, y3, y4, y5)
