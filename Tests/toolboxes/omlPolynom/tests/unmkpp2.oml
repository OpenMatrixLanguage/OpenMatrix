addtoolbox omlpolynom

breaks = [101, 102, 103, 104, 105, 106];
L = length(breaks) - 1;
k = 3;
d = 2;
coefs = zeros(d, L, k);
coefs(1, 1, :) = [111, 112, 113];
coefs(1, 2, :) = [121, 122, 123];
coefs(1, 3, :) = [131, 132, 133];
coefs(1, 4, :) = [141, 142, 143];
coefs(1, 5, :) = [151, 152, 153];
coefs(2, 1, :) = coefs(1, 1, :) + 100;
coefs(2, 2, :) = coefs(1, 2, :) + 100;
coefs(2, 3, :) = coefs(1, 3, :) + 100;
coefs(2, 4, :) = coefs(1, 4, :) + 100;
coefs(2, 5, :) = coefs(1, 5, :) + 100;
pp = mkpp(breaks,coefs,d);
[breaks,coefs,l,k,d] = unmkpp(pp)