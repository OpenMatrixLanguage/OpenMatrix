% movefile-note move directory to a sub-directory; move wild card files back


cd FileManipulation

dir1 = 'dir1';
dir2 = 'dir2';

name = 'movefile_src_09';
src1 = [name, '1.txt'];
src2 = [name, '2.txt'];

mkdir(dir1);
mkdir(dir2);
csvwrite([dir1 , '/', src1], eye(2));
csvwrite([dir1 , '/', src2], eye(2));

success = movefile([dir1 , '/', name, '*'], dir2, 'f')
pause(1);
fileexist = exist([dir2, '/', src1])
fileexist = exist([dir2, '/', src2])

success = movefile([dir2, '/*.*'], '.', 'f')
pause(.4);

delete(src1);
delete(src2);
rmdir(dir1);
rmdir(dir2);
