% movefile-note move between <file> and <dir>/file

cd FileManipulation

src    = 'movefile_src_03.txt';
dstdir = 'movefiledir_03';
dst    = [dstdir, '/', src];

% Create the source
csvwrite(src, eye(2));
mkdir(dstdir);

% File to dir
success = movefile(src, dst)
dstexist = exist(dst)

% Dir to file
success = movefile(dst, src)
dstexist = exist(src)

delete(src);
rmdir(dstdir);
