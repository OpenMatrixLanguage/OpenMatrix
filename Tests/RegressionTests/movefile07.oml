% movefile-note move directory to a sub-directory. then move directory back using its name.

cd FileManipulation

dir1 = 'dir1';
dir2 = 'dir2';

name = 'movefile_src_07';
src1 = [name, '1.txt'];
src2 = [name, '2.txt'];

mkdir(dir1);
mkdir(dir2);
csvwrite([dir1 , '/', src1], eye(2));
csvwrite([dir1 , '/', src2], eye(2));

success = movefile(dir1, dir2)
fileexist = exist([dir2, '/', dir1, '/', src1])
fileexist = exist([dir2, '/', dir1, '/', src1])

success = movefile([dir2, '/', dir1], '.')
fileexist = exist([dir1, '/', src1])

delete([dir1, '/', src1]);
delete([dir1, '/', src2]);

rmdir(dir2);
rmdir(dir1);