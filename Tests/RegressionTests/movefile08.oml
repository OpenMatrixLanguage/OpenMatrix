% movefile-note move directory to a sub-directory. then move directory back to the current directory.


cd FileManipulation

dir1 = 'dir1';
dir2 = 'dir2';

mkdir(dir1);
mkdir(dir2);

success = movefile(dir1, dir2)
fileexist = exist([dir2, '/', dir1])

success = movefile([dir2, '/', dir1], '.')
fileexist = exist(dir1)

rmdir(dir1);
rmdir(dir2);
