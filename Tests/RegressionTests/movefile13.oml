% movefile-note copy files to cause normal movefile to fail retrieving multiple nargouts

cd FileManipulation

dir1 = 'dir1';

name = 'movefile_src_13';
src1 = [name, '_1.txt'];
src2 = [name, '_2.txt'];

csvwrite(src1, eye(2));
csvwrite(src2, eye(2));

[r, m, c] = movefile(src1, src2)
[r, m, c] = movefile(src1, src2, 'f')

try
  [r, m, c] = movefile(dir1, src2)
end  

delete(src2)